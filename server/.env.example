# Copy to server/.env and fill in. Never commit the real file.

# Atlas connection string. The database name goes between the host and the "?"
# or mongoose quietly uses one called "test" instead
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobs-app?retryWrites=true&w=majority

# Where the frontend is served from. The vite dev server locally, the vercel
# url in production
CLIENT_ORIGIN=http://localhost:5173

# Render sets this itself, so it is only needed locally
PORT=3000
